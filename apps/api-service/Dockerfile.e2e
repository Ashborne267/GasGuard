# ── Build Stage ──────────────────────────────────────────────────────────
FROM node:20.18.0-alpine3.20 AS builder

WORKDIR /app

# Copy dependency specifications
COPY package*.json ./
COPY tsconfig*.json ./

# Install dependencies
RUN npm ci && \
    npm cache clean --force

# Copy source and test definitions
COPY src/ ./src/
COPY test/ ./test/

# Compile application
RUN npm run build

# ── Hardened Test Runner Stage ───────────────────────────────────────────
FROM node:20.18.0-alpine3.20 AS runner

# Install tini for signal management
RUN apk add --no-cache tini ca-certificates && \
    rm -rf /var/cache/apk/* /tmp/* /root/.npm

WORKDIR /app

# Create unprivileged non-root user
RUN addgroup -g 10001 -S gasguard && \
    adduser -S -D -H -u 10001 -h /app -s /sbin/nologin -G gasguard -g "GasGuard Service Account" gasguard

# Copy compiled files and runtime assets with non-root ownership
COPY --from=builder --chown=gasguard:gasguard /app/node_modules ./node_modules
COPY --from=builder --chown=gasguard:gasguard /app/dist ./dist
COPY --from=builder --chown=gasguard:gasguard /app/package*.json ./
COPY --from=builder --chown=gasguard:gasguard /app/test ./test

# Environment defaults
ENV NODE_ENV=test \
    PORT=3000

EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3000/health || exit 1

# Enforce non-root execution
USER gasguard

ENTRYPOINT ["/sbin/tini", "--"]

CMD ["npm", "run", "start:prod"]
